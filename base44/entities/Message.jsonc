{
  "name": "Message",
  "type": "object",
  "properties": {
    "matter_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "owner",
        "client",
        "network_attorney"
      ]
    },
    "recipient_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "attachment_url": {
      "type": "string"
    }
  },
  "required": [
    "matter_id",
    "sender_id",
    "content"
  ]
}